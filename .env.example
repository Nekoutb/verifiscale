# =============================================================================
# FiscAudit Pro — Environment Configuration
# Copy this file to `.env` and fill in real values before running docker compose
# =============================================================================

# --- Postgres ---
POSTGRES_USER=fiscaudit
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=fiscaudit
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO (object storage) ---
MINIO_ROOT_USER=fiscaudit
MINIO_ROOT_PASSWORD=changeme_minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=fiscaudit-files

# --- API (FastAPI) ---
API_PORT=8000
API_HOST=0.0.0.0
JWT_SECRET=changeme_generate_a_64_byte_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=240
CORS_ORIGINS=http://localhost:3000

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- DGI integrations (placeholders until access granted) ---
DGI_FCA_API_URL=
DGI_FCA_API_KEY=
DGI_EINVOICE_API_URL=
DGI_EINVOICE_API_KEY=

# --- Claude API (invoice OCR via Vision) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
