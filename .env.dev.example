# =============================================================================
# VerifiScale — DEV environment template  ->  copy to .env.dev ON THE SERVER
#   cp .env.dev.example .env.dev   (.env.dev is git-ignored, never commit it)
#
# ⚠️  METERED / OUTWARD-FACING SERVICES — READ BEFORE FILLING IN
# Anything dev sends is REAL. There is no sandbox that magically catches it.
#   * MAILERSEND_API_KEY — leave EMPTY (default). The mailer degrades gracefully
#     to a no-op and the UI keeps showing copyable invitation links, so the whole
#     onboarding flow is still testable WITHOUT sending mail to real inboxes.
#     Filling this in means dev emails land in real mailboxes and burn quota.
#     MailerSend does offer a separate trial/sandbox domain — use that, never the
#     production key, and only ever send to your own team addresses.
#   * ANTHROPIC_API_KEY — leave EMPTY (default). Invoice OCR then runs in mock
#     mode. A real key here bills real money on every uploaded PDF.
# =============================================================================

# --- Database (dev has its OWN Postgres container + volume) ------------------
POSTGRES_USER=fiscaudit_dev
POSTGRES_PASSWORD=change_me_generate_a_long_random_value
POSTGRES_DB=fiscaudit_dev

# --- Auth --------------------------------------------------------------------
# MUST differ from production. A different secret means a prod token is invalid
# on dev and vice versa, so the two environments can never share a session.
JWT_SECRET=change_me_generate_a_long_random_value

# --- URLs --------------------------------------------------------------------
APP_BASE_URL=https://dev.verifiscale.com
NEXT_PUBLIC_API_URL=https://dev.verifiscale.com
CORS_ORIGINS=https://dev.verifiscale.com

# --- Metered services: EMPTY ON PURPOSE (see warning above) ------------------
MAILERSEND_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

MAIL_FROM_EMAIL=no-reply@dev.verifiscale.com
MAIL_FROM_NAME=VerifiScale (DEV)
MAIL_REPLY_TO=

# --- Image tags (deploy script overrides these; defaults reuse prod images) ---
API_IMAGE=cmimpot-api:latest
WEB_IMAGE=cmimpot-web:latest
